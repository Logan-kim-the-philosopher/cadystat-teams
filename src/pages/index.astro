---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Badge } from '../components/ui/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../components/ui/card';
import { MetricCard } from '../components/app/metric-card';
import { SectionTitle } from '../components/app/section-title';
import { meetings, stats, teams, tickets } from '../lib/site-data';

const priorityVariant = (priority: string) => {
  if (priority === '긴급') return 'red';
  if (priority === '높음') return 'amber';
  return 'muted';
};
---

<SiteLayout title="대시보드 · cody-stat" description="팀 운영 포털 대시보드">
  <section class="grid gap-6 xl:grid-cols-[1.5fr_0.9fr]">
    <Card className="overflow-hidden border-0 bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800 text-white shadow-soft">
      <div class="flex flex-col gap-6 p-8">
        <div class="flex flex-wrap items-center gap-2">
          <Badge variant="blue">전체 회의 준비</Badge>
          <Badge variant="outline" className="border-white/15 text-white/80">Plane 연동형</Badge>
        </div>
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-300">운영 레이어</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">팀, 티켓, 회의록을 한 화면에서 정리합니다.</h1>
          <p class="mt-4 max-w-xl text-sm leading-7 text-slate-300 sm:text-base">
            이 UI는 Plane 연동 구조를 유지하면서, 내부 운영에 맞는 더 단정한 shadcn 스타일 포털로 보여줍니다.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="/tickets" class="rounded-xl bg-white px-4 py-2.5 font-medium text-slate-950 transition hover:bg-slate-100">티켓 접수함 열기</a>
          <a href="/organization" class="rounded-xl border border-white/15 px-4 py-2.5 font-medium text-white/90 transition hover:bg-white/5">조직도 보기</a>
        </div>
      </div>
    </Card>

    <div class="grid gap-4 sm:grid-cols-3 xl:grid-cols-1">
      {stats.map((item) => (
        <MetricCard label={item.label} value={item.value} hint={item.hint} />
      ))}
    </div>
  </section>

  <section class="mt-8">
    <SectionTitle
      eyebrow="요약"
      title="현재 운영 상태"
      description="접수, 담당, 전체 회의 후속 조치를 한눈에 보는 가벼운 대시보드입니다."
    >
      <Badge variant="outline">실시간 요약</Badge>
    </SectionTitle>

    <div class="mt-6 grid gap-6 xl:grid-cols-3">
      <Card>
        <CardHeader>
          <CardTitle className="text-lg">팀</CardTitle>
          <CardDescription>담당과 구조</CardDescription>
        </CardHeader>
        <CardContent>
          <div class="space-y-4">
            {teams.map((team) => (
              <a href={`/organization/${team.slug}`} class="block rounded-xl border border-border p-4 transition hover:bg-muted/50">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <div class="flex items-center gap-2">
                      <h3 class="font-semibold">{team.name}</h3>
                      <Badge variant={team.tone}>{team.lead ?? '팀장 없음'}</Badge>
                    </div>
                    <p class="mt-2 text-sm leading-6 text-muted-foreground">{team.description}</p>
                  </div>
                  <div class="text-right text-sm text-muted-foreground">
                    <div>{team.members}명</div>
                    <div>열린 티켓 {team.tickets}개</div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle className="text-lg">접수 큐</CardTitle>
          <CardDescription>최근 버그와 기능 요청</CardDescription>
        </CardHeader>
        <CardContent>
          <div class="space-y-3">
            {tickets.map((ticket) => (
              <a href={`/tickets/${ticket.id}`} class="block rounded-xl border border-border p-4 transition hover:bg-muted/50">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <h3 class="font-semibold">{ticket.id}</h3>
                      <Badge variant={priorityVariant(ticket.priority)}>{ticket.priority}</Badge>
                      <Badge variant="outline">{ticket.type}</Badge>
                    </div>
                    <p class="mt-2 text-sm leading-6">{ticket.title}</p>
                    <p class="mt-1 text-xs text-muted-foreground">{ticket.team} · {ticket.status} · {ticket.createdAt}</p>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle className="text-lg">전체 회의</CardTitle>
          <CardDescription>회사 전체 회의록</CardDescription>
        </CardHeader>
        <CardContent>
          <div class="space-y-3">
            {meetings.map((meeting) => (
              <a href={`/meetings/${meeting.slug}`} class="block rounded-xl border border-border p-4 transition hover:bg-muted/50">
                <p class="text-sm font-medium text-muted-foreground">{meeting.date}</p>
                <h3 class="mt-1 font-semibold">{meeting.title}</h3>
                <p class="mt-2 text-sm text-muted-foreground">결정사항 {meeting.decisions} · 댓글 {meeting.comments}</p>
              </a>
            ))}
          </div>
        </CardContent>
      </Card>
    </div>
  </section>
</SiteLayout>
