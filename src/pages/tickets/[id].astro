---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { Badge } from '../../components/ui/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../components/ui/card';
import { ticketDetails } from '../../lib/site-data';

export function getStaticPaths() {
  return Object.keys(ticketDetails).map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const ticket = ticketDetails[id];
const priorityVariant = (priority: string) => {
  if (priority === '긴급') return 'red';
  if (priority === '높음') return 'amber';
  return 'muted';
};
---

<SiteLayout title={`${ticket?.id ?? '티켓'} · 티켓`} description="티켓 상세 화면">
  {ticket ? (
    <div class="grid gap-6 xl:grid-cols-[1.1fr_0.9fr]">
      <Card>
        <CardHeader>
          <div class="flex flex-wrap items-center gap-2">
            <Badge variant={priorityVariant(ticket.priority)}>{ticket.priority}</Badge>
            <Badge variant="outline">{ticket.type}</Badge>
            <Badge variant="blue">{ticket.status}</Badge>
          </div>
          <CardTitle className="text-3xl">{ticket.title}</CardTitle>
          <CardDescription>{ticket.description}</CardDescription>
        </CardHeader>
        <CardContent>
          <div class="grid gap-3 sm:grid-cols-3">
            <div class="rounded-xl border border-border bg-muted/50 p-4">
              <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground">담당 팀</p>
              <p class="mt-2 font-medium">{ticket.ownerTeam}</p>
            </div>
            <div class="rounded-xl border border-border bg-muted/50 p-4">
              <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground">담당자</p>
              <p class="mt-2 font-medium">{ticket.assignee}</p>
            </div>
            <div class="rounded-xl border border-border bg-muted/50 p-4">
              <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground">제보자</p>
              <p class="mt-2 font-medium">{ticket.reporter}</p>
            </div>
          </div>
        </CardContent>
      </Card>

      <div class="space-y-6">
        <Card>
          <CardHeader>
            <CardTitle className="text-lg">이력</CardTitle>
            <CardDescription>이관 및 상태 변경</CardDescription>
          </CardHeader>
          <CardContent>
            <ol class="space-y-3 text-sm text-muted-foreground">
              {ticket.history.map((item: string, index: number) => (
                <li class="flex gap-3">
                  <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary text-xs text-primary-foreground">{index + 1}</span>
                  <span>{item}</span>
                </li>
              ))}
            </ol>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle className="text-lg">댓글</CardTitle>
            <CardDescription>팀 대화</CardDescription>
          </CardHeader>
          <CardContent>
            <div class="space-y-3 text-sm text-muted-foreground">
              {ticket.comments.map((item: string) => <div class="rounded-xl border border-border bg-muted/40 p-3">{item}</div>)}
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle className="text-lg">연결된 회의록</CardTitle>
            <CardDescription>이 티켓이 논의된 회의</CardDescription>
          </CardHeader>
          <CardContent>
            <div class="space-y-2">
              {ticket.linkedMeetings.map((meetingId: string) => (
                <a href={`/meetings/${meetingId}`} class="block rounded-xl border border-border p-3 text-sm transition hover:bg-muted/50">
                  {meetingId}
                </a>
              ))}
            </div>
          </CardContent>
        </Card>
      </div>
    </div>
  ) : (
    <Card>
      <CardHeader>
        <CardTitle className="text-lg">티켓을 찾을 수 없음</CardTitle>
      </CardHeader>
      <CardContent>
        <p class="text-sm text-muted-foreground">요청한 티켓이 존재하지 않습니다.</p>
      </CardContent>
    </Card>
  )}
</SiteLayout>
