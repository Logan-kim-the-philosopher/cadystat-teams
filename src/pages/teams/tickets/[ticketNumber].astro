---
import { formatTimestamp } from '../../../lib/platform/time.mjs';
import { Badge } from '../../../components/ui/badge';
import { getTicket } from '../../../features/teams/server/ticket-repository';
import TeamsLayout from '../../../layouts/TeamsLayout.astro';

const ticketNumber = Astro.params.ticketNumber ?? '';
let ticket = null;
let loadFailed = false;
try {
  ticket = await getTicket(ticketNumber);
} catch (error) {
  loadFailed = true;
  console.error('[teams/tickets/detail] failed to render ticket', error);
}
if (!ticket) Astro.response.status = loadFailed ? 503 : 404;
---

<TeamsLayout title={ticket ? `${ticket.number} · Codystat-Teams` : '티켓 없음 · Codystat-Teams'} description="Teams 티켓 상세">
  <article class="mx-auto max-w-4xl pb-12">
    <a class="text-base font-medium text-muted-foreground hover:text-foreground" href="/teams/tickets">← 티켓 보드</a>
    {ticket ? (
      <>
        <header class="mt-5 border-b border-border pb-8">
          <div class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">{ticket.number}</p><h1 class="mt-3 text-balance text-4xl font-semibold tracking-tight">{ticket.title}</h1></div><div class="flex gap-2"><Badge variant={ticket.status === '완료' ? 'green' : ticket.status === '배정' ? 'amber' : 'blue'}>{ticket.status}</Badge><Badge variant="outline">{ticket.typeName}</Badge></div></div>
        </header>
        <dl class="mt-7 grid gap-4 rounded-2xl border border-border bg-card p-5 text-sm sm:grid-cols-2"><div><dt class="text-muted-foreground">담당 팀</dt><dd class="mt-1 font-semibold">{ticket.teamName ?? '미배정'}</dd></div><div><dt class="text-muted-foreground">담당자</dt><dd class="mt-1 font-semibold">{ticket.assigneeName ?? '미지정'}</dd></div></dl>
        <p class="mt-8 whitespace-pre-wrap text-sm leading-8 text-foreground">{ticket.description}</p>
        <div class="mt-12 grid gap-6 lg:grid-cols-2">
          <section class="rounded-2xl border border-border bg-card p-6 shadow-soft"><h2 class="text-lg font-semibold">댓글 {ticket.comments.length}개</h2><div class="mt-3 divide-y">{ticket.comments.map((comment) => <article class="py-4"><div class="flex justify-between gap-3 text-xs text-muted-foreground"><b>{comment.author}</b><time>{formatTimestamp(comment.createdAt)}</time></div><p class="mt-2 whitespace-pre-wrap text-sm leading-6">{comment.body}</p></article>)}</div></section>
          <details class="rounded-2xl border border-border bg-card p-6 shadow-soft"><summary class="cursor-pointer text-lg font-semibold">변경 이력 보기</summary><ol class="mt-3 space-y-3">{ticket.history.map((entry) => <li class="rounded-xl border border-border bg-muted/50 px-4 py-3"><p class="text-sm font-medium">{entry.event}</p><time class="mt-1 block text-xs text-muted-foreground">{formatTimestamp(entry.createdAt)}</time></li>)}</ol></details>
        </div>
      </>
    ) : <div role="alert" class="mt-6 rounded-2xl border border-border bg-card p-7"><h1 class="text-xl font-semibold">{loadFailed ? '티켓 데이터 연결 실패' : '티켓을 찾을 수 없음'}</h1><p class="mt-2 text-sm text-muted-foreground">{loadFailed ? '잠시 후 다시 시도해 주세요.' : '요청한 티켓이 존재하지 않습니다.'}</p></div>}
  </article>
</TeamsLayout>
