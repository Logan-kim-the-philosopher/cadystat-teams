
# Temporary legacy SQLite adapter. New Teams routes use Supabase.
SQLITE_PATH=./data/codystat.sqlite
SQLITE_SEED=1

# Teams server-only Supabase access. Never prefix the secret with PUBLIC_.
CODY_STAT_SUPABASE_URL=
CODY_STAT_SUPABASE_SERVICE_ROLE_KEY=

# Link back to the Cody Stat Playground from the independent Teams service.
PUBLIC_CODY_STAT_HOME_URL=https://codystat.com/
