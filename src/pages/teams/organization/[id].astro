---
import { Badge } from '../../../components/ui/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../../components/ui/card';
import { OrganizationInputError, parseOrganizationId, type OrganizationTeam } from '../../../features/teams/domain/organization';
import { getOrganizationTeam } from '../../../features/teams/server/organization-repository';
import TeamsLayout from '../../../layouts/TeamsLayout.astro';

const rawId = Astro.params.id;
let team: OrganizationTeam | null = null;
let loadFailed = false;
try {
  team = await getOrganizationTeam(parseOrganizationId(rawId));
  if (!team) Astro.response.status = 404;
} catch (error) {
  if (error instanceof OrganizationInputError) Astro.response.status = 404;
  else {
    Astro.response.status = 503;
    loadFailed = true;
    console.error('[teams/organization/detail] failed to render team', error);
  }
}
const lead = team?.members.find((member) => member.id === team.leadMemberId) ?? null;
---

<TeamsLayout title={`${team?.name ?? '팀'} · Codystat-Teams`} description="Teams 조직 상세">
  <section>
    <a class="text-base font-medium text-muted-foreground hover:text-foreground" href="/teams/organization">← 조직도로 돌아가기</a>
    {team ? (
      <div class="mt-7 grid gap-6 xl:grid-cols-[1.15fr_0.85fr]">
        <Card>
          <CardHeader>
            <div class="mb-2 flex flex-wrap items-center gap-2"><Badge variant={lead ? 'blue' : 'muted'}>{lead ? `리드 · ${lead.name}` : '수평 조직'}</Badge><Badge variant="outline">{team.members.length}명</Badge></div>
            <CardTitle className="text-3xl">{team.name}</CardTitle>
            <CardDescription>팀과 구성원 관계</CardDescription>
          </CardHeader>
          <CardContent>
            <div class="space-y-3">{team.members.map((member) => <div class="flex items-center justify-between gap-4 rounded-xl border border-border px-4 py-3"><div><p class="font-medium">{member.name}</p><p class="text-sm text-muted-foreground">{member.title}</p></div>{member.id === team.leadMemberId ? <Badge variant="outline">리드</Badge> : null}</div>)}{team.members.length === 0 ? <p class="text-sm text-muted-foreground">등록된 구성원이 없습니다.</p> : null}</div>
          </CardContent>
        </Card>
        <Card>
          <CardHeader><CardTitle className="text-lg">팀 정보</CardTitle><CardDescription>현재 조직 관계와 표시 프로필</CardDescription></CardHeader>
          <CardContent>
            <dl class="space-y-4 text-sm"><div class="flex items-center justify-between gap-4"><dt class="text-muted-foreground">리더</dt><dd class="font-medium">{lead?.name ?? '없음'}</dd></div><div class="flex items-center justify-between gap-4"><dt class="text-muted-foreground">멤버 수</dt><dd class="font-medium">{team.members.length}</dd></div><div class="flex items-center justify-between gap-4"><dt class="text-muted-foreground">상위 팀</dt><dd class="max-w-56 break-all text-right font-mono text-xs">{team.parentTeamId ?? '없음'}</dd></div><div class="flex items-center justify-between gap-4"><dt class="text-muted-foreground">프로필 성격</dt><dd class="text-right">화면용 표시 프로필</dd></div></dl>
          </CardContent>
        </Card>
      </div>
    ) : <div role="alert" class="mt-7 rounded-2xl border border-border bg-card p-7"><h1 class="text-xl font-semibold">{loadFailed ? '조직 데이터 연결 실패' : '팀을 찾을 수 없음'}</h1><p class="mt-2 text-sm text-muted-foreground">{loadFailed ? '잠시 후 다시 시도해 주세요.' : '요청한 팀 ID가 존재하지 않습니다.'}</p></div>}
  </section>
</TeamsLayout>
