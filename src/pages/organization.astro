---
import SiteLayout from '../layouts/SiteLayout.astro';
import { OrganizationFlow } from '../components/app/organization-flow';
import { getRepository } from '../lib/server/repository';

const orgUnits = getRepository().getOrganizationUnits();

---

<SiteLayout title="조직도 · Codystat-Teams" description="팀 구조와 담당 맵" fullBleed>
  <div class="relative">
    <OrganizationFlow client:only="react" units={orgUnits} />
  </div>
</SiteLayout>
