---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { TicketBrowser } from '../../components/app/ticket-browser';
import { getRepository } from '../../lib/server/repository';

const { tickets, teams } = getRepository().getTickets();
const ticketDetails = Object.fromEntries(tickets.map((ticket) => [ticket.id, ticket.detail]));
---

<SiteLayout title="티켓 · Codystat-Teams" description="버그와 기능 요청을 받는 단일 접수 큐">
  <div>
    <TicketBrowser client:load tickets={tickets} teams={teams.map(({ name, slug }) => ({ name, slug }))} details={ticketDetails} />
  </div>
</SiteLayout>
